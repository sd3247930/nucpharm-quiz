{
  "name": "nucpharm-quiz",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "核药通：离线核药学题库、练习与模拟考试",
  "scripts": {
    "build:h5": "node scripts/build.mjs h5",
    "build:app": "node scripts/build.mjs app",
    "build:android": "node scripts/build-android.mjs",
    "test": "node --import ./tests/support/register.mjs --test tests/unit/*.test.mjs tests/integration/*.test.mjs",
    "test:e2e": "node --test tests/e2e/*.test.mjs",
    "test:security": "node --test test/dependencies.test.mjs",
    "audit:check": "npm audit --audit-level=low"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-alpha-5020520260821001",
    "@dcloudio/uni-app-plus": "3.0.0-alpha-5020520260821001",
    "@dcloudio/uni-components": "3.0.0-alpha-5020520260821001",
    "@dcloudio/uni-h5": "3.0.0-alpha-5020520260821001",
    "vue": "3.5.42",
    "vue-i18n": "9.14.5",
    "vue-router": "4.4.4"
  },
  "devDependencies": {
    "@dcloudio/vite-plugin-uni": "3.0.0-alpha-5020520260821001",
    "@dcloudio/uni-cli-shared": "3.0.0-alpha-5020520260821001",
    "sass": "1.105.1",
    "vite": "6.4.3",
    "braces": "file:vendor/braces"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "vite": "$vite",
    "vue": "$vue",
    "vue-i18n": "$vue-i18n",
    "@vue/server-renderer": "$vue",
    "@babel/core": "7.29.7",
    "@intlify/core-base": "9.14.5",
    "@intlify/shared": "9.14.5",
    "adm-zip": "0.6.1",
    "esbuild": "0.25.12",
    "express": "4.22.3",
    "postcss": "8.5.23",
    "postcss-selector-parser": "7.1.6",
    "source-map-js": "1.2.2",
    "qs": "6.16.0",
    "@intlify/message-resolver": "9.1.11",
    "braces": "$braces"
  }
}
